generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Audit {
  id          String    @id @default(cuid())
  name        String
  agentPrompt String?
  status      String    @default("pending")
  totalCalls  Int       @default(0)
  failedCalls Int       @default(0)
  failureRate Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  calls       Call[]
  testRuns    TestRun[]
}

model Call {
  id          String       @id @default(cuid())
  auditId     String
  audioUrl    String?
  transcript  String
  language    String
  status      String       @default("pending")
  summary     String?
  createdAt   DateTime     @default(now())
  audit       Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  entities    Entity[]
  toolCalls   ToolCall[]
  comparisons  Comparison[]
  policyChecks PolicyCheck[]
}

model Entity {
  id              String       @id @default(cuid())
  callId          String
  type            String
  rawValue        String
  normalizedValue String
  confidence      Float
  sourceLayer     String
  timestampStart  Float?
  timestampEnd    Float?
  call            Call         @relation(fields: [callId], references: [id], onDelete: Cascade)
  comparisons     Comparison[]
}

model ToolCall {
  id           String       @id @default(cuid())
  callId       String
  functionName String
  arguments    String
  response     String?
  timestamp    DateTime?
  call         Call         @relation(fields: [callId], references: [id], onDelete: Cascade)
  comparisons  Comparison[]
}

model Comparison {
  id            String    @id @default(cuid())
  callId        String
  entityId      String?
  toolCallId    String?
  expectedValue String
  actualValue   String
  match         Boolean
  rootCause     String?
  evidence      String?
  severity      String
  reviewStatus  String    @default("pending")
  reviewNote    String?
  reviewedAt    DateTime?
  call          Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  entity        Entity?   @relation(fields: [entityId], references: [id])
  toolCall      ToolCall? @relation(fields: [toolCallId], references: [id])
}

model TestRun {
  id            String        @id @default(cuid())
  auditId       String?
  scenarioName  String
  scenarioPack  String        @default("custom")
  status        String        @default("pending")
  totalChecks   Int           @default(0)
  passedChecks  Int           @default(0)
  failedChecks  Int           @default(0)
  transcript    String?
  toolCalls     String?
  finalState    String?
  createdAt     DateTime      @default(now())
  audit         Audit?        @relation(fields: [auditId], references: [id], onDelete: SetNull)
  policyChecks  PolicyCheck[]
}

model PolicyCheck {
  id          String   @id @default(cuid())
  testRunId   String?
  callId      String?
  policyPack  String
  rule        String
  passed      Boolean
  evidence    String?
  severity    String   @default("warning")
  createdAt   DateTime @default(now())
  testRun     TestRun? @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  call        Call?    @relation(fields: [callId], references: [id], onDelete: Cascade)
}
